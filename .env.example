# 复制为 .env 后按需修改（docker compose 会自动读取）

# 首次启动用它初始化管理员口令，至少 8 位。留空则服务端随机生成并打印在启动日志里
WB_ADMIN_PASSWORD=ChangeMe123456

# 数据主密钥：32 字节，64 位 hex 或 base64。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 不填则首次启动自动生成到 data/master.key（此时务必备份该文件）
WB_MASTER_KEY=

# 对外访问地址，用于在代理页生成正确的 Base URL，例如 https://wb.example.com
WB_PUBLIC_URL=

# 浏览器空闲自动关闭的等待分钟数（扫码登录用的无头 Chromium）。
# 浏览器实例跨任务复用，不关就永久常驻（小内存服务器上约 200~500MB）。
# 默认 10 分钟；设 0 表示不自动关闭。
WB_BROWSER_IDLE_MINUTES=10

# 监听配置（一般不用改；容器内固定为 0.0.0.0:8790）
# PORT=8790
# HOST=0.0.0.0
# WB_DATA_DIR=/app/data

# 是否部署在反向代理（Nginx/Caddy）之后。设为 1 才信任 X-Forwarded-Proto，
# 会话 Cookie 会带上 Secure 属性。直连（http://IP:8790）必须保持 0 或不设，
# 否则任意客户端伪造该头即可让服务端下发明文下不可用的 Cookie。
WB_TRUST_PROXY=0
